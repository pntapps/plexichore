<Window x:Class="PlexiChore.App.Views.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="PlexiChore — Approve tablet"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Plexi.Font}" Foreground="{StaticResource Plexi.TextBrush}"
        Icon="/Assets/PlexiChore.ico">
    <Grid Margin="24">
        <Border CornerRadius="24" Background="{StaticResource Plexi.HeroGradient}" BorderBrush="{StaticResource Plexi.HeroBorder}" BorderThickness="1.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="#05030C" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="24" Padding="30,26,30,26" MouseLeftButtonDown="OnDrag" Background="Transparent">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Plexi.GhostButton}" Foreground="{StaticResource Plexi.TextTertiaryBrush}" Click="OnReject" Padding="6" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/logo-256.png" Width="22" Height="22" />
                        <TextBlock Text="PlexiChore · New connection" Margin="9,0,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="#B5AED0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <Border Width="72" Height="72" CornerRadius="22" Background="{StaticResource Plexi.AccentGradient}" Margin="0,22,0,0" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.7" Color="#7C4DFF" />
                    </Border.Effect>
                    <ui:SymbolIcon Symbol="Tablet24" FontSize="36" Foreground="White" />
                </Border>

                <TextBlock x:Name="DeviceNameText" Text="Galaxy Tab S8" HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="22" FontWeight="SemiBold"
                           FontFamily="{StaticResource Plexi.DisplayFont}" Foreground="White" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="wants to use this PC as a display over Wi‑Fi" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="13.5" Foreground="#C9C3E0" />

                <TextBlock Text="Make sure the tablet shows the same code" HorizontalAlignment="Center" Margin="0,22,0,10" FontSize="12" Foreground="#8E88A8" />
                <ItemsControl x:Name="CodeDigits" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="58" Height="68" CornerRadius="14" Margin="5,0" Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <TextBlock Text="{Binding}" FontSize="34" FontWeight="Bold" FontFamily="{StaticResource Plexi.DisplayFont}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Plexi.AccentGradientH}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <CheckBox x:Name="RememberBox" IsChecked="True" Content="Trust this tablet next time" Margin="0,22,0,0" HorizontalAlignment="Center" Foreground="#C9C3E0" />

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Plexi.SecondaryButton}" Padding="0,12" Click="OnReject" HorizontalAlignment="Stretch" Content="Reject" />
                    <Button Grid.Column="2" Style="{StaticResource Plexi.PrimaryButton}" Padding="0,12" Click="OnApprove" HorizontalAlignment="Stretch" IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Foreground="White" />
                            <TextBlock Text="Approve" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="CountdownText" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="11.5" Foreground="#6F6A85" Text="Expires in 60 s" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
