<UserControl x:Class="PlexiChore.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="RowIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource Plexi.TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <StackPanel Margin="28,6,36,36" MaxWidth="1040">
            <TextBlock Text="Settings" Style="{StaticResource Plexi.PageTitle}" />
            <TextBlock Style="{StaticResource Plexi.PageSubtitle}" Text="Startup, security and streaming preferences." />

            <TextBlock Text="GENERAL" Style="{StaticResource Plexi.SectionHeader}" />
            <Border Style="{StaticResource Plexi.SettingRow}">
                <DockPanel>
                    <ui:SymbolIcon Symbol="Power24" Style="{StaticResource RowIcon}" />
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" FontSize="14" />
                        <TextBlock Text="Launch quietly in the tray when you sign in, so tablets can connect any time." Style="{StaticResource Plexi.Caption}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Plexi.SettingRow}">
                <DockPanel>
                    <ui:SymbolIcon Symbol="Alert24" Style="{StaticResource RowIcon}" />
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShowConnectNotifications}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Notify when a tablet connects" FontSize="14" />
                        <TextBlock Text="Show a notification from the tray icon." Style="{StaticResource Plexi.Caption}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="SECURITY" Style="{StaticResource Plexi.SectionHeader}" />
            <Border Style="{StaticResource Plexi.SettingRow}">
                <DockPanel>
                    <ui:SymbolIcon Symbol="ShieldKeyhole24" Style="{StaticResource RowIcon}" />
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding RequireApprovalForWifi}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Require approval for new Wi‑Fi tablets" FontSize="14" />
                        <TextBlock Text="Unknown tablets must show a matching 4‑digit code before they can see your screen. USB is always trusted." Style="{StaticResource Plexi.Caption}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Plexi.SettingRow}">
                <StackPanel>
                    <DockPanel>
                        <ui:SymbolIcon Symbol="Shield24" Style="{StaticResource RowIcon}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Plexi.SecondaryButton}" Command="{Binding AddFirewallRulesCommand}"
                                Visibility="{Binding FirewallOk, Converter={StaticResource InvBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldAdd24" FontSize="15" />
                                <TextBlock Text="Add firewall rules" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Plexi.Badge}" Background="{StaticResource Plexi.GreenSoftBrush}" Margin="0"
                                Visibility="{Binding FirewallOk, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Foreground="{StaticResource Plexi.GreenBrush}" />
                                <TextBlock Text="Configured" Style="{StaticResource Plexi.BadgeText}" Foreground="{StaticResource Plexi.GreenBrush}" Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Windows Firewall" FontSize="14" />
                            <TextBlock Text="{Binding FirewallText}" Style="{StaticResource Plexi.Caption}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding FirewallError}" Foreground="#FFB3C1" Margin="36,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding FirewallError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Plexi.SettingRow}" Padding="18,14,18,8">
                <StackPanel>
                    <DockPanel>
                        <ui:SymbolIcon Symbol="PeopleCheckmark24" Style="{StaticResource RowIcon}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Trusted tablets" FontSize="14" />
                            <TextBlock Text="These tablets connect over Wi‑Fi without asking. Remove one to require the code again." Style="{StaticResource Plexi.Caption}" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding TrustedDevices}" Margin="36,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Plexi.SubtleBrush}" CornerRadius="10" Padding="14,9" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Plexi.GhostButton}" Foreground="#FF8FA3" Content="Remove"
                                                Command="{Binding DataContext.RemoveTrustedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" VerticalAlignment="Center" />
                                        <ui:SymbolIcon Symbol="Tablet24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Plexi.Caption}">
                                                <Run Text="{Binding AddedText, Mode=OneWay}" /><Run Text="  ·  id " /><Run Text="{Binding ShortId, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No trusted tablets yet." Style="{StaticResource Plexi.Caption}" Margin="36,0,0,8"
                               Visibility="{Binding HasTrustedDevices, Converter={StaticResource InvBoolToVis}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="STREAMING" Style="{StaticResource Plexi.SectionHeader}" />
            <Border Style="{StaticResource Plexi.SettingRow}">
                <DockPanel>
                    <ui:SymbolIcon Symbol="Video24" Style="{StaticResource RowIcon}" />
                    <ComboBox DockPanel.Dock="Right" Width="290" SelectedIndex="{Binding EncoderIndex}">
                        <ComboBoxItem Content="Hardware (GPU) — recommended" />
                        <ComboBoxItem Content="Software (CPU)" />
                    </ComboBox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Preferred video encoder" FontSize="14" />
                        <TextBlock Text="Hardware H.264 is fastest. Use software if you see artifacts or your GPU has no encoder." Style="{StaticResource Plexi.Caption}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="DIAGNOSTICS" Style="{StaticResource Plexi.SectionHeader}" />
            <Border Style="{StaticResource Plexi.SettingRow}">
                <DockPanel>
                    <ui:SymbolIcon Symbol="DocumentText24" Style="{StaticResource RowIcon}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Plexi.SecondaryButton}" Content="Open logs folder" Command="{Binding OpenLogsCommand}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Logs" FontSize="14" />
                        <TextBlock Text="{Binding LogsPath}" Style="{StaticResource Plexi.Caption}" FontFamily="Cascadia Mono, Consolas" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
