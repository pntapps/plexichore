<Application x:Class="PlexiChore.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:PlexiChore.App.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/PlexiTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <v:BoolToVisibilityConverter x:Key="BoolToVis" />
            <v:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
            <v:ToneToBrushConverter x:Key="ToneBrush" />
            <v:ToneToBrushConverter x:Key="ToneSoftBrush" Soft="True" />
            <v:IndexToVisibilityConverter x:Key="PageVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
