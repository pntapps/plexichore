<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox: required for the private CGVirtualDisplay API, CGEvent injection
	     (Accessibility) and launching adb. This also means: not eligible for the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Only relevant if the sandbox is ever enabled; harmless otherwise. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
